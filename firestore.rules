rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      // Anyone can view public musician profiles
      allow read: if true;
      // Users can only create or update their own profile
      allow write: if isOwner(userId);
    }

    // Username reservation registry
    match /usernames/{username} {
      // Anyone can check if a username exists
      allow read: if true;
      // Authenticated users can reserve an available username
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Owners can update or release their username
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Published Tracks
    match /tracks/{trackId} {
      // Anyone can listen to and view public tracks
      allow read: if true;
      // Authenticated users can publish tracks where authorUid equals their auth.uid
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      // Authors can edit or delete their own published tracks; allow incrementing play count or voting (upvotes, downvotes, score)
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'score']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount', 'upvotes', 'downvotes', 'score']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount', 'commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount', 'upvotes', 'downvotes', 'score', 'commentCount'])
      );
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;

      // Votes subcollection to record user votes
      match /votes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read track comments
        allow read: if true;
        // Authenticated users can write comments if they are the author
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        // Comment authors can update or delete their own comments
        allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
