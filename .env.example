# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_UMAMI_WEBSITE_ID: Umami Analytics Website ID (UUID)
VITE_UMAMI_WEBSITE_ID=

# STRIPE_SECRET_KEY: Secret API key from Stripe Dashboard (sk_live_... or sk_test_...)
# Used by server API to create secure Stripe Checkout sessions for Gold VIP Supporter upgrades
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Secret for verifying Stripe webhook events (whsec_...)
STRIPE_WEBHOOK_SECRET=

# STRIPE_MONTHLY_PRICE_ID: Optional Price ID for $4.99/mo Pro Supporter subscription (auto-created dynamically if unset)
STRIPE_MONTHLY_PRICE_ID=

# STRIPE_YEARLY_PRICE_ID: Optional Price ID for $49.00/yr Pro Supporter subscription (auto-created dynamically if unset)
STRIPE_YEARLY_PRICE_ID=

# STRIPE_LIFETIME_PRICE_ID: Optional Price ID for $99.00 Lifetime Pro Supporter (defaults to $99 one-time if unset)
STRIPE_LIFETIME_PRICE_ID=

# STRIPE_PRICE_ID: Optional fallback Price ID
STRIPE_PRICE_ID=
